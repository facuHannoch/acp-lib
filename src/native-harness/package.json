{
  "name": "native-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/interfaces/cli/main.ts start",
    "chat": "bun run src/interfaces/cli/main.ts chat",
    "serve": "bun run src/interfaces/cli/main.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "test:scenario": "bun run src/interfaces/cli/scenario.ts",
    "suspend": "bun run src/interfaces/cli/main.ts suspend",
    "resume": "bun run src/interfaces/cli/main.ts resume",
    "status": "bun run src/interfaces/cli/main.ts status"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
